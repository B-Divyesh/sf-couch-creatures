{
  "responseOverrides": { "404": { "rewrite": "/404.html" } },
  "routes": [
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/controller", "rewrite": "/index.html" },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/moss-rescue.webp", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/404.css", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/social-card.webp", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  }
}
